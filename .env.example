# คัดลอกเป็น .env แล้วแก้ค่า (อย่า commit ไฟล์ .env)
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/expense
# ใช้ true ถ้าเชื่อมต่อ Supabase/Neon ที่บังคับ SSL
DATABASE_SSL=false
# สุ่มสร้างด้วย: openssl rand -base64 32  (ต้องยาวอย่างน้อย 32 ตัวอักษร)
JWT_SECRET=
# Channel ID ของ LINE Login channel ที่ผูกกับ LIFF app (ใช้ตอน verify ID token)
LINE_CHANNEL_ID=
# เปิดทางเข้าสำหรับทดสอบโดยไม่ต้องใช้ LINE เปิดเฉพาะตอนพัฒนา ห้ามเปิดบน production
DEV_AUTH=true
CORS_ORIGIN=http://localhost:5173
# ที่อยู่ที่ลิงก์เชิญจะพาไปเปิด (ถ้าไม่ตั้งจะใช้ค่าเดียวกับ CORS_ORIGIN)
# ตอนใช้ LIFF ให้ตั้งเป็น https://liff.line.me/<liffId>
APP_URL=http://localhost:5173
